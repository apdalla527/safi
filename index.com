<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Safi Electrical - Electrical Supplies in Migori</title>
  <meta name="description" content="Safi Electrical, Migori, Kenya: heavy gauge conduit pipes, sockets, MCB breakers and electrical cables in different sizes. Call 0727391350.">
  <style>
    :root { --blue:#0a4da2; --dark:#0f172a; --yellow:#fbbf24; --light:#f1f5f9; --green:#25d366; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:Arial, Helvetica, sans-serif; color:var(--dark); background:var(--light); line-height:1.5; }
    header { background:var(--blue); color:#fff; padding:14px 20px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:10; flex-wrap:wrap; gap:6px; }
    header .logo { font-size:1.4rem; font-weight:bold; }
    header .logo span { color:var(--yellow); }
    header a { color:#fff; text-decoration:none; margin-left:14px; font-size:.95rem; }
    .hero { background:linear-gradient(135deg,#0a4da2,#0f172a); color:#fff; text-align:center; padding:60px 20px; }
    .hero h1 { font-size:2.1rem; margin-bottom:10px; }
    .hero h1 span { color:var(--yellow); }
    .hero p { max-width:540px; margin:0 auto 22px; color:#e2e8f0; }
    .btn { display:inline-block; padding:12px 26px; border-radius:8px; text-decoration:none; font-weight:bold; margin:6px; }
    .btn-wa { background:var(--green); color:#fff; }
    .btn-call { background:var(--yellow); color:var(--dark); }
    section { padding:44px 20px; max-width:1100px; margin:0 auto; }
    h2 { text-align:center; margin-bottom:6px; font-size:1.6rem; color:var(--blue); }
    .sub { text-align:center; color:#64748b; margin-bottom:26px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:18px; }
    .card { background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; flex-direction:column; }
    .card .img { height:170px; background:#e2e8f0; display:flex; align-items:center; justify-content:center; font-size:3rem; }
    .card .img img { width:100%; height:100%; object-fit:cover; display:block; }
    .card .body { padding:14px; display:flex; flex-direction:column; flex:1; }
    .card h3 { font-size:1.05rem; margin-bottom:4px; }
    .card .size { color:var(--blue); font-weight:bold; margin-bottom:4px; }
    .card .tag { font-size:.8rem; color:#64748b; margin-bottom:12px; }
    .card a { margin-top:auto; text-align:center; background:var(--green); color:#fff; padding:10px; border-radius:8px; text-decoration:none; font-weight:bold; font-size:.92rem; }
    .contact { background:var(--dark); color:#fff; text-align:center; max-width:none; }
